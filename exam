def do_op_args(r):
    op = r.choice("+-*/%")
    if op in "+-":
        a, b = r.randint(-1000000000, 1000000000), r.randint(-1000000000, 1000000000)
    elif op == "*":
        a, b = r.randint(-40000, 40000), r.randint(-40000, 40000)
    else:
        a, b = r.randint(-100000, 100000), r.choice([i for i in range(-500, 501) if i])
    return [str(a), op, str(b)]

