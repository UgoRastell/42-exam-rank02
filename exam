def subject_args(ex):
    """Arguments des exemples du sujet : lignes « $>./prog ... »."""
    out = []
    for line in ex["subject"].splitlines():
        m = re.match(r"\s*\$>\s*\./\S+(.*)$", line)
        if not m:
            continue
        cmd = re.sub(r"\|\s*cat\s+-e\s*$", "", m.group(1)).strip()
        try:
            out.append(shlex.split(cmd))
        except ValueError:
            pass
    return out


def cat_e(b):
    """Comme cat -e : $ en fin de ligne, ^X pour les caractères de contrôle, M- au-delà de 127."""
    if not b:
        return "(rien)\n"
    out = []
    for x in b:
        pre = ""
        if x >= 128:
            pre, x = "M-", x - 128
        if x == 10 and not pre:
            out.append("$\n")
        elif x < 32 or x == 127:
            out.append(pre + "^" + chr(x ^ 64))
        else:
            out.append(pre + chr(x))
    return "".join(out)


def run(binary, args):
    try:
        p = subprocess.run([binary] + args, capture_output=True, timeout=3)
    except subprocess.TimeoutExpired:
        return None, "timeout (boucle infinie ?)"
    if p.returncode < 0:
        import signal
        return p.stdout, f"crash : {signal.Signals(-p.returncode).name}"
    return p.stdout, None


def compile_to(srcs, out, includes, objdir, werror=True, link=True):
    """Compile chaque source en .o puis lie (si link). Renvoie (ok, messages, objets)."""
    os.makedirs(objdir, exist_ok=True)
    objs = []
    for s in srcs:
        o = os.path.join(objdir, os.path.basename(s) + ".o")
        flags = CFLAGS if werror else [STD, "-w"]
        p = subprocess.run(["cc"] + flags + includes + ["-c", s, "-o", o], capture_output=True, text=True)
        if p.returncode:
            return False, p.stderr, objs
        objs.append(o)
    if not link:
        return True, "", objs
    p = subprocess.run(["cc"] + objs + ["-o", out], capture_output=True, text=True)
    if p.returncode:
        return False, p.stderr, objs
    return True, "", objs


def external_calls(objs):
    names = set()
    for o in objs:
        p = subprocess.run(["nm", "-u", o], capture_output=True, text=True)
        for line in p.stdout.split():
            if line != "U" and not line.startswith("_"):
                names.add(line.split("@")[0])
    return names


def grade(ex):
    name, rd = ex["name"], os.path.join(RENDU, ex["name"])
    build = os.path.join(BUILD, name)
    shutil.rmtree(build, ignore_errors=True)
    os.makedirs(build)
    trace = []

    def fail(title, details=""):
        trace.append(title + ("\n\n" + details if details else ""))
        os.makedirs(TRACES, exist_ok=True)
        with open(os.path.join(TRACES, f"{name}.txt"), "w") as f:
            f.write("\n".join(trace) + "\n")
        print(RED(f"✗ FAILURE : {title}"))
        if details:
            print(details.rstrip())
        return False

    # 1. fichiers attendus
    # « *.c, *.h » : au moins un .c ; sinon chaque fichier nommé doit exister
    missing, user_c = [], []
    for f in ex["files"]:
        if "*" in f:
            found = sorted(glob.glob(os.path.join(rd, f)))
            if f.endswith(".c") and not found:
                missing.append(f)
            user_c += [x for x in found if x.endswith(".c")]
        elif not os.path.isfile(os.path.join(rd, f)):
            missing.append(f)
        elif f.endswith(".c"):
            user_c.append(os.path.join(rd, f))
    if missing:
        return fail("fichier(s) manquant(s) : " + ", ".join(missing), f"Attendu dans {rd}/")

    # 2. compilation (ton code avec -Wall -Wextra -Werror ; le main de test à part)
    main = os.path.join(ex["path"], "main.c")
    inc_user = ["-I" + rd, "-I" + os.path.join(ex["path"], "include")]
    ok, err, objs = compile_to(user_c, os.path.join(build, "user"), inc_user, os.path.join(build, "o_user"),
                               link=not ex["function"])
    if not ok:
        return fail("ton code ne compile pas (cc -Wall -Wextra -Werror)", err)
    if ex["function"]:
        if any(re.search(r"\bT main$", subprocess.run(["nm", o], capture_output=True, text=True).stdout, re.M)
               for o in objs):
            return fail("ton fichier contient un main : pour une fonction, rends seulement la fonction")
        p = subprocess.run(["cc", STD, "-w"] + inc_user + [main] + objs + ["-o", os.path.join(build, "user")],
                           capture_output=True, text=True)
        if p.returncode:
            return fail("l'édition de liens avec le main de test échoue (prototype ou nom différent ?)", p.stderr)

    # 3. fonctions autorisées
    used = external_calls(objs)
    # printf autorisé : le compilateur peut le remplacer par puts/putchar
    implied = {"puts", "putchar"} if "printf" in ex["allowed"] else set()
    bad = sorted(used - ex["allowed"] - COMPILER_ADDED - implied)
    if bad:
        allowed = ", ".join(sorted(ex["allowed"])) or "aucune"
        hint = ""
        if set(bad) & {"puts", "putchar"}:
            hint = "\n(le compilateur transforme printf en puts/putchar : cherche un printf)"
        return fail("fonction(s) interdite(s) : " + ", ".join(bad), f"Autorisées : {allowed}{hint}")

    # 4. référence
    ref_srcs = [os.path.join(ex["path"], "ref.c")] + ([main] if ex["function"] else [])
    ok, err, _ = compile_to(ref_srcs, os.path.join(build, "ref"), ["-I" + os.path.join(ex["path"], "include")],
                            os.path.join(build, "o_ref"), werror=False)
    if not ok:
        return fail("erreur interne : la référence ne compile pas", err)

    # 5. tests
    if ex["function"]:
        tests = [[]]
    else:
        r = random.Random()
        tests = subject_args(ex) + EXTRA.get(name, [])
        tests += [GEN[name](r) for _ in range(RANDOM_TESTS)] if name in GEN else []
    for i, args in enumerate(tests, 1):
        exp, eerr = run(os.path.join(build, "ref"), args)
        got, gerr = run(os.path.join(build, "user"), args)
        if gerr or got != exp:
            cmd = f"./{name} " + shlex.join(args) if not ex["function"] else "programme de test (main de la moulinette)"
            detail = f"Test {i}/{len(tests)} : {cmd}\n"
            if gerr:
                detail += f"\n{gerr}\n"
            if ex["function"] and not gerr:
                el, gl = cat_e(exp).splitlines(), cat_e(got).splitlines()
                for k in range(max(len(el), len(gl))):
                    a = el[k] if k < len(el) else "(fin)"
                    b = gl[k] if k < len(gl) else "(fin)"
                    if a != b:
                        detail += f"\nPremière différence, ligne {k + 1} :\n  attendu : {a}\n  obtenu  : {b}\n"
                        break
            elif not gerr:
                detail += f"\nAttendu (cat -e) :\n{cat_e(exp)}\nObtenu (cat -e) :\n{cat_e(got)}"
            return fail("mauvaise sortie" if not gerr else gerr, detail)
    print(G(f"✓ SUCCESS") + D(f" — {len(tests)} test(s) passé(s)"))
    return True


# ───────────────────────────── commandes ─────────────────────────────
def need_session():
    st = load_state()
    if not st or not st.get("current"):
        sys.exit("Pas de session en cours : lance « exam start ».")
    return st


def wipe():
    """Nouvel examen : efface rendu/, subjects/, traces/ et les binaires de correction,
    comme une session d'examen qui démarre sur un dossier vide."""
    old = [os.path.relpath(os.path.join(dp, f), RENDU)
           for dp, _, fs in os.walk(RENDU) for f in fs] if os.path.isdir(RENDU) else []
    for d in (RENDU, SUBJECTS, TRACES, BUILD):
        shutil.rmtree(d, ignore_errors=True)
    os.makedirs(RENDU)
    os.makedirs(SUBJECTS)
    if old:
        print(D(f"Ancien travail effacé ({len(old)} fichier(s) dans rendu/)."))


def cmd_start(argv, exos):
    level = int(argv[0]) if argv else 1
    if not 1 <= level <= MAX_LEVEL:
        sys.exit(f"Niveau entre 1 et {MAX_LEVEL}.")
    wipe()
    st = {"started": time.time(), "passed": (load_state() or {}).get("passed", []), "history": []}
    ex = pick(st, exos, level)
    print(M(f"── Examen lancé — niveau {level}/{MAX_LEVEL} : {B(ex['name'])}"))
    show_subject(ex)


def cmd_status(_, exos):
    st = need_session()
    if st.get("finished"):
        print(G(f"Examen terminé : 100/100 en {elapsed(st)}.") + " Relance avec « exam start ».")
        return
    ex = exos[st["current"]]
    score = (st["level"] - 1) * 100 // MAX_LEVEL
    print(f"Niveau {B(st['level'])}/{MAX_LEVEL} · exercice {B(ex['name'])} · "
          f"score {score}/100 · tentatives {st['attempts']} · temps {elapsed(st)}")
    for h in st["history"]:
        print(D(f"  ✓ niveau {h['level']} : {h['name']} ({h['attempts']} tentative(s))"))


def cmd_subject(_, exos):
    show_subject(exos[need_session()["current"]])


def cmd_grademe(_, exos):
    st = need_session()
    if st.get("finished"):
        return cmd_status(_, exos)
    ex = exos[st["current"]]
    print(M(f"── Correction de {ex['name']} (niveau {st['level']}, tentative {st['attempts'] + 1})"))
    st["attempts"] += 1
    if not grade(ex):
        save_state(st)
        print(D(f"Corrige et relance « exam grademe » (détail : exam trace)."))
        return
    st["history"].append({"level": st["level"], "name": ex["name"], "attempts": st["attempts"]})
    if ex["name"] not in st["passed"]:
        st["passed"].append(ex["name"])
    if st["level"] >= MAX_LEVEL:
        st["finished"] = True
        save_state(st)
        print(G(B(f"\n🎉 Examen réussi : 100/100 en {elapsed(st)} !")))
        return
    nxt = pick(st, exos, st["level"] + 1)
    print(G(f"\nScore : {(st['level'] - 1) * 100 // MAX_LEVEL}/100 → niveau {st['level']} : {B(nxt['name'])}"))
    show_subject(nxt)


def cmd_skip(_, exos):
    st = need_session()
    ex = pick(st, exos, st["level"], avoid=st["current"])
    print(Y(f"Nouvel exercice niveau {st['level']} : {B(ex['name'])}"))
    show_subject(ex)


def cmd_pick(argv, exos):
    if not argv or argv[0] not in exos:
        sys.exit("usage : exam pick <nom>   (voir exam list)")
    ex = exos[argv[0]]
    st = load_state() or {"started": time.time(), "passed": [], "history": []}
    st.pop("finished", None)
    st.update(level=ex["level"], current=ex["name"], attempts=0)
    save_state(st)
    install(ex)
    show_subject(ex)


def cmd_list(_, exos):
    passed = set((load_state() or {}).get("passed", []))
    for lvl in range(1, MAX_LEVEL + 1):
        names = [e["name"] for e in exos.values() if e["level"] == lvl]
        done = sum(n in passed for n in names)
        print(M(f"Niveau {lvl}") + D(f" ({done}/{len(names)})"))
        for n in names:
            kind = "fonction" if exos[n]["function"] else "programme"
            print(f"  {G('✓') if n in passed else ' '} {n:<20}{D(kind)}")


def cmd_trace(_, exos):
    st = need_session()
    path = os.path.join(TRACES, f"{st['current']}.txt")
    print(open(path).read() if os.path.exists(path) else "Pas de trace pour cet exercice.")


def cmd_solution(_, exos):
    st = need_session()
    ex = exos[st["current"]]
    if st["attempts"] == 0:
        print(Y("Tu n'as pas encore essayé « exam grademe ». Le jour de l'examen, pas de solution !"))
    if input("Afficher la solution de référence ? (o/N) ").strip().lower() not in ("o", "oui", "y"):
        return
    print(D("─" * 80))
    print(open(os.path.join(ex["path"], "ref.c")).read())
    print(D("(référence de correction : écrite pour être courte, pas à la norme)"))


COMMANDS = {"start": cmd_start, "grademe": cmd_grademe, "status": cmd_status, "subject": cmd_subject,
            "skip": cmd_skip, "pick": cmd_pick, "list": cmd_list, "trace": cmd_trace,
            "solution": cmd_solution}

if __name__ == "__main__":
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help") or args[0] not in COMMANDS:
        print(__doc__)
        sys.exit(0 if not args or args[0] in ("-h", "--help", "help") else 1)
    COMMANDS[args[0]](args[1:], exercises())
