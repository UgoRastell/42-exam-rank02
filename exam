#!/usr/bin/env python3
"""exam — simulateur d'examen 42 (01_Exam_C-language), niveaux 1 à 4.

  exam start [niveau]   nouvelle session (niveau 1 par défaut), sujet tiré au hasard
  exam grademe          corrige l'exercice en cours (comme la moulinette)
  exam status           niveau, exercice, temps écoulé, tentatives
  exam subject          réaffiche le sujet
  exam skip             change d'exercice dans le même niveau (entraînement)
  exam pick <nom>       choisit un exercice précis
  exam list             tous les exercices, ✓ ceux déjà réussis
  exam trace            détail du dernier échec
  exam solution         montre la solution de référence (après avoir essayé !)

Ton code va dans ~/42/exam/rendu/<exercice>/, le sujet dans ~/42/exam/subjects/<exercice>/.
"""
import glob, json, os, random, re, shlex, shutil, string, subprocess, sys, time

ROOT = os.path.dirname(os.path.realpath(__file__))
EXDIR = os.path.join(ROOT, ".exercises")
RENDU = os.path.join(ROOT, "rendu")
SUBJECTS = os.path.join(ROOT, "subjects")
TRACES = os.path.join(ROOT, "traces")
STATE = os.path.join(ROOT, ".state.json")
BUILD = os.path.expanduser("~/.cache/42exam")
MAX_LEVEL = 4
# -std=gnu17 : comme les postes de 42 (GCC >= 15 passe en C23, où « int (*f)() » veut dire « sans argument »)
STD = "-std=gnu17"
CFLAGS = [STD, "-Wall", "-Wextra", "-Werror"]
RANDOM_TESTS = 25
# Le compilateur insère parfois ces appels (ex. int tab[256] = {0} → memset) : pas ta faute
COMPILER_ADDED = {"memset", "memcpy", "memmove"}

TTY = sys.stdout.isatty()
def c(code, s): return f"\033[{code}m{s}\033[0m" if TTY else s
G = lambda s: c("32", s); RED = lambda s: c("31", s); Y = lambda s: c("33", s)
B = lambda s: c("1", s); D = lambda s: c("2", s); M = lambda s: c("35", s)


# ───────────────────────────── exercices ─────────────────────────────
def exercises():
    out = {}
    for lvl in range(1, MAX_LEVEL + 1):
        d = os.path.join(EXDIR, f"level{lvl}")
        for name in sorted(os.listdir(d)):
            path = os.path.join(d, name)
            subject = open(os.path.join(path, "subject.en.txt")).read()
            files = re.search(r"Expected files\s*:\s*(.*)", subject).group(1)
            allowed = re.search(r"Allowed functions\s*:\s*(.*)", subject)
            allowed = allowed.group(1) if allowed else ""
            out[name] = {
                "name": name, "level": lvl, "path": path, "subject": subject,
                "files": [f.strip() for f in files.split(",") if f.strip()],
                "allowed": {a.strip() for a in re.split(r"[,\s]+", allowed)
                            if a.strip() and a.strip().lower() != "none"},
                "function": os.path.exists(os.path.join(path, "main.c")),
            }
    return out


def load_state():
    try:
        return json.load(open(STATE))
    except (OSError, ValueError):
        return None


def save_state(st):
    json.dump(st, open(STATE, "w"), indent=2)


def elapsed(st):
    s = int(time.time() - st["started"])
    return f"{s // 3600}h{s % 3600 // 60:02d}"


def install(ex):
    """Pose le sujet dans subjects/ et prépare rendu/<nom>/ (sans écraser ton travail)."""
    sd = os.path.join(SUBJECTS, ex["name"])
    os.makedirs(sd, exist_ok=True)
    shutil.copy(os.path.join(ex["path"], "subject.en.txt"), sd)
    os.makedirs(os.path.join(RENDU, ex["name"]), exist_ok=True)


def show_subject(ex):
    print(D("─" * 80))
    print(ex["subject"].rstrip())
    print(D("─" * 80))
    print(f"Écris ton code dans {B(os.path.join(RENDU, ex['name']))}/  "
          f"({', '.join(ex['files'])}), puis : {B('exam grademe')}")


def pick(st, exos, level, avoid=None):
    pool = [e for e in exos.values() if e["level"] == level and e["name"] != avoid]
    ex = random.choice(pool)
    st.update(level=level, current=ex["name"], attempts=0)
    save_state(st)
    install(ex)
    return ex


# ───────────────────────────── tests ─────────────────────────────
def rnd_str(r, alphabet, lo=0, hi=30):
    return "".join(r.choice(alphabet) for _ in range(r.randint(lo, hi)))

PRINT = string.ascii_letters + string.digits + " .,;:!?'-_*/"
WORDY = string.ascii_letters + "   \t\t.,"
SMALL = "abcdefgh ."

def camel(r):
    words = [rnd_str(r, string.ascii_lowercase, 1, 6) for _ in range(r.randint(1, 5))]
    return words[0] + "".join(w.capitalize() for w in words[1:])

def snake(r):
    return "_".join(rnd_str(r, string.ascii_lowercase, 1, 6) for _ in range(r.randint(1, 5)))

